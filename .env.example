# copy to .env (gitignored) and fill in. never commit the real one.

ES_URL=https://<siem-vm-ip>:9200
KIBANA_URL=http://<siem-vm-ip>:5601

# API key (preferred) or user/password. Stack Management -> API keys
ES_API_KEY=
ES_USER=elastic
ES_PASS=

# CA from the ubuntu box: /etc/elasticsearch/certs/http_ca.crt
# copy it to this machine and put the path here (*.crt is gitignored)
ES_CA_CERT=
# only needed if Kibana is on https with its own CA
KIBANA_CA_CERT=
# false skips cert checks entirely. last resort if the CA won't cooperate
VERIFY_TLS=true

LAB_INDEX=logs-*
# windows VM hostname as it shows up in host.name. blank = don't filter by host
LAB_HOST=
